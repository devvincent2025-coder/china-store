APP_NAME=ChinaInNigeria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# If port 80 is already taken on your machine (e.g. XAMPP/MAMP Apache), set APP_PORT to something
# else (e.g. 8080) and update APP_URL to match (http://localhost:8080).
# APP_PORT=8080

# Default UI locale and fallback when a translation is missing. Supported: en, zh, fr.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL via Sail. These match the service name/credentials Sail's docker-compose.yml generates —
# do not point DB_HOST at 127.0.0.1 when running through Sail, since "mysql" is the container's
# hostname on the docker-compose network.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
# If something else on your machine (e.g. XAMPP/Homebrew MySQL) already occupies host port 3306,
# uncomment this to remap Sail's forwarded port — DB_PORT above stays 3306 either way, since that's
# the container-internal port the app connects to over the docker-compose network.
# FORWARD_DB_PORT=33061

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Every job that calls Korapay or Supabase Storage is queued so those API calls never block a request —
# the "database" driver works out of the box with no extra service, but Sail also ships Redis if
# you'd rather switch QUEUE_CONNECTION=redis for higher throughput.
#
# Shared hosting with no way to keep a `queue:work` daemon alive? Set this to "sync" instead —
# every queued job then runs immediately, in-request, no worker needed at all (notifications get
# emailed the instant they're triggered). App\Jobs\CreateVendorSubaccount, EnhanceProductImage,
# and VerifyVendorBankAccount each pin themselves to "database" regardless of this setting (they
# call external APIs and shouldn't block the request that triggers them), so they still need
# `queue:work` running (or the cron-driven one in routes/console.php) — everything else, almost
# entirely notifications, follows whatever you set here. Switch back to "database" (or "redis")
# once you're on a host that can run a persistent worker.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is sent via queued jobs (see App\Notifications\*). MAIL_MAILER=smtp + Mailpit works out of
# the box under Sail for local dev (view caught emails at http://localhost:8025). For production,
# switch to MAIL_MAILER=resend and set RESEND_API_KEY below.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@chinainnigeria.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production email provider (leave blank locally — Mailpit is used instead). Get this key from
# https://resend.com after verifying the chinainnigeria.com sending domain.
RESEND_API_KEY=

# --- Korapay (payments + split payments) --------------------------------------------------------
# Get these from your Korapay merchant dashboard: https://dashboard.korapay.com -> Settings -> API Keys.
# KORAPAY_SECRET_KEY is used server-side ONLY for resolve-account, subaccount creation, charge
# initialization, and verifying webhook signatures — never expose it to the frontend.
# KORAPAY_PUBLIC_KEY is safe for client-side use but this app doesn't currently need it, since
# checkout redirects to Korapay's hosted payment page rather than embedding their inline widget.
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=

# --- Supabase Storage (image/document upload) ----------------------------------------------------
# From your Supabase project dashboard: Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY bypasses storage policies — server-side only, never expose it to the
# frontend. Create two Storage buckets before running the app: one PUBLIC (product images, banners,
# store branding) and one PRIVATE (vendor ID/CAC documents — served only via short-lived signed
# URLs, never a permanent link, since these are sensitive documents).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_PUBLIC_BUCKET=public
SUPABASE_STORAGE_PRIVATE_BUCKET=private

# --- SmartSMSSolutions (phone OTP: buyer signup, vendor KYC) --------------------------------------
# See App\Services\Sms\SmsService. Leaving username/password blank keeps the app in log-only mode
# (no real SMS sent — fine for local dev, since OTP codes stay visible at /dev/otps).
SMARTSMS_USERNAME=
SMARTSMS_PASSWORD=
SMARTSMS_SENDER_ID=ChinaInNG

# No SMS gateway account yet, or it's down? Set this to false: a phone number is accepted and
# marked verified immediately, with no code sent or asked for, at both buyer signup and vendor KYC
# — see config/services.php's 'smart_sms.phone_otp_required' for exactly what this changes. Set
# back to true once a real gateway is configured.
PHONE_OTP_REQUIRED=true

# --- Poof (poof.bg) background removal for vendor product photos ---------------------------------
# See App\Services\Image\PoofBackgroundRemovalService. Sign up at poof.bg for a free API key (100
# credits/month, no card needed). Leaving the key blank just skips this step — photos are still
# compressed as before, they just keep their original background.
POOF_API_KEY=
PRODUCT_BACKGROUND_REMOVAL_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
# Set to your machine's LAN IP (e.g. 192.168.1.127) to load the dev server on a phone/other device
# on the same WiFi — leave as localhost if you only ever access the app from this machine.
VITE_DEV_HOST=localhost
